{
  "name": "niva-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "NIVA Launcher for Windows 10/11 x64",
  "main": "src/main/index.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build": "npm run typecheck && vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:dir": "npm run build && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.niva.launcher",
    "productName": "NIVA Launcher",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "assets/brand/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/brand/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "NIVA-Launcher-Portable-${version}-x64.${ext}"
    },
    "artifactName": "NIVA-Launcher-Setup-${version}-x64.${ext}"
  }
}
